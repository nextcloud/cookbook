{
    "css.validate": false,
    "less.validate": false,
    "scss.validate": false,
    "intelephense.environment.includePaths": [
        "../../lib/public"
    ],
    "intelephense.files.exclude": [
        "**/.git/**",
        "**/.svn/**",
        "**/.hg/**",
        "**/CVS/**",
        "**/node_modules/**",
        "**/bower_components/**",
        "**/vendor/**/{Tests,tests}/**",
        "**/.history/**",
        "**/vendor/**/vendor/**",

        "**/.github/actions/**",
        "**/.hook-checkout/**",

        "**/vendor-bin/**",
        "vendor/nextcloud/ocp/**"
    ],
    "intelephense.references.exclude": [
        "**/vendor/**",
        ".github/actions/run-tests/volumes/**"
    ]
}
